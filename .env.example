# ERP SOLUTION — Environment Configuration
#
# Copy to .env and fill in values:
#   cp .env.example .env && chmod 600 .env
#
# Generated against backend/app/config.py (Settings, 27 fields) — the keys below
# are exactly the ones the app reads. Note the two consumers:
#
#   * The backend loads ./.env relative to backend/, so `backend/.env` is the
#     file that actually configures local runs.
#   * docker-compose.yml interpolates ${VAR} from the .env at the repo ROOT.
#     Both files therefore need DATABASE_URL / SECRET_KEY / ENVIRONMENT, and
#     they must AGREE — a token signed with one SECRET_KEY is invalid under the
#     other. Keep SECRET_KEY identical in both.
#
# ENVIRONMENT accepts only dev | test | prod (Settings uses a Literal). The old
# "development" value in this file made Settings() raise on startup.

# ============================================
# APPLICATION
# ============================================
APP_NAME=ERP SOLUTION System
APP_VERSION=1.8.0
DEBUG=false
ENVIRONMENT=dev
# Options: dev, test, prod. prod is fail-closed: it refuses to boot with the
# placeholder SECRET_KEY, a SECRET_KEY under 32 chars, or the example DB creds.

# ============================================
# DATABASE
# ============================================
# Full DSN, not separate fields — the app never reads DB_USER/DB_PASSWORD.
# Host must be `localhost` for the venv, `postgres` inside compose.
DATABASE_URL=postgresql://erp_user:CHANGE_ME@localhost:5432/erp_db
# The compose file needs these three to configure the postgres service.
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_32_CHARS_MIN
POSTGRES_DB=erp_db

# SQLAlchemy pool (honored by app.database.get_engine)
POOL_SIZE=10
POOL_MAX_OVERFLOW=20
POOL_RECYCLE=1800

# ============================================
# REDIS CACHE
# ============================================
# DSN form. Leave the password empty when Redis runs without requirepass.
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY
# ============================================
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_256_BIT_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS
# ============================================
# Comma-separated, or a JSON array. The Vite dev server listens on 3000 (see
# backend/frontend-react/vite.config.js); 5173 is the CRA default, kept for
# convenience. In production, list only your real origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# AI / LLM
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============================================
# BILLING
# ============================================
# Optional — blank is fine unless the billing routes are exercised.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================
# EMAIL
# ============================================
# Optional. For Gmail use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ============================================
# WEBSOCKET
# ============================================
WS_HEARTBEAT_INTERVAL=30

# ============================================
# NOT read by the backend
# ============================================
# Listed so nobody chases them after seeing them in a template. The app has no
# S3/MinIO backend, no hosted-LLM client, and no build-time mobile config.
#   OPENAI_API_KEY, STORAGE_TYPE, AWS_*        — unimplemented integrations
#   SENTRY_DSN                                  — no Sentry SDK dependency
#   EXPO_PROJECT_ID, EAS_BUILD_PROFILE          — Expo CLI reads these from
#     mobile/app.json, which does not exist; mobile/src/utils/api.ts currently
#     hardcodes its base URL.
#   JWT_ALGORITHM                               — the real key is ALGORITHM above