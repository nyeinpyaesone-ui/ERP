# ===========================================
# ERP SYSTEM - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and configure for your environment
# IMPORTANT: Never commit .env files to version control!

# -------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_123
POSTGRES_DB=erp_solution
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp:CHANGE_ME_SECURE_PASSWORD_123@localhost:5432/erp_solution

# -------------------------------------------
# REDIS CACHE
# -------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------
# SECURITY - CHANGE THESE IN PRODUCTION!
# -------------------------------------------
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_MIN_32_CHARS
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="ERP System"

# -------------------------------------------
# CORS SETTINGS
# -------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:19006
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# -------------------------------------------
# AI / LLM CONFIGURATION
# -------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
ENABLE_AI_FEATURES=True
OPENAI_API_KEY=sk-your-openai-key-here

# -------------------------------------------
# FILE STORAGE
# -------------------------------------------
STORAGE_TYPE=local
UPLOAD_DIR=./backend/static/uploads
MAX_UPLOAD_SIZE=104857600

# S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_BUCKET_NAME=your-bucket
AWS_REGION=ap-southeast-1

# -------------------------------------------
# MONITORING & LOGGING
# -------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
SENTRY_DSN=
ENABLE_METRICS=True
ENABLE_TRACING=False

# -------------------------------------------
# EMAIL CONFIGURATION
# -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -------------------------------------------
# PAYMENT GATEWAYS
# -------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_ENABLED=True
