# ERP SOLUTION — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DB_USER=erp
DB_PASSWORD=your-strong-password-here
DB_NAME=erp_solution

# ============================================
# REDIS CACHE
# ============================================
REDIS_PASSWORD=your-redis-password

# ============================================
# SECURITY
# ============================================
SECRET_KEY=change-this-to-a-256-bit-random-string
# Generate: openssl rand -hex 32
# NOTE: The backend refuses to start if SECRET_KEY is empty or left at its default.

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://app.yourdomain.com

# ============================================
# AI / LLM
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
# Alternative: https://api.openai.com/v1

OPENAI_API_KEY=sk-your-openai-key
# Required for GPT-4 features (leave empty to use Ollama only)

OLLAMA_MODEL=llama3.1

# ============================================
# FILE STORAGE (planned — not yet implemented in backend)
# ============================================
# NOTE: app code currently stores uploads on local disk only; there is no
# S3/MinIO client in the backend. These keys are reserved for a future
# storage feature and are NOT wired into docker-compose or config.py.
STORAGE_TYPE=local
# Options: local, s3, minio

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-southeast-1

# ============================================
# STRIPE (optional — leave EMPTY to disable payment features)
# ============================================
# Paste real keys only in .env, never commit them. Use test keys (sk_test_/pk_test_) locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=
# Leave empty to disable Sentry; paste the real DSN only in .env (never commit it)
ENVIRONMENT=development
# Options: development, staging, production

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# MOBILE
# ============================================
EXPO_PROJECT_ID=your-expo-project-id
EAS_BUILD_PROFILE=development

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ============================================
# WEBSOCKET
# ============================================
WS_HEARTBEAT_INTERVAL=30
# Frontend (Vite build-time)
VITE_API_URL=/api/v1
VITE_WS_URL=ws://localhost:8000
