# ERP SOLUTION — Staging runtime environment template
# Copy to /opt/erp-solution/.env.staging on the staging host.
# Generate UNIQUE values for this environment. Never reuse production secrets.
# chmod 600 /opt/erp-solution/.env.staging

DB_USER=erp
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24
DB_NAME=erp_solution_staging

REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set this to the actual staging frontend origin.
CORS_ORIGINS=https://staging-app.yourdomain.com

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional integrations: leave blank unless staging has separate test credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Backend configuration accepts dev|test|prod. Staging is selected by the
# deployment target and uses this separate runtime file, not ENVIRONMENT=staging.
ENVIRONMENT=prod

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800
WS_HEARTBEAT_INTERVAL=30

# Must match the Docker Hub namespace configured in GitHub Actions.
DOCKER_USER=CHANGE_ME_DOCKER_NAMESPACE
VERSION=latest
