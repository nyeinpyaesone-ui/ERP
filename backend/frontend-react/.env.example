# Frontend build-time variables (Vite). Only VITE_-prefixed keys are
# exposed to the browser bundle — never put secrets here.
#
# Base URL for the API. Leave unset in normal deployments: axios then uses
# the same-origin default `/api/v1`, which nginx (prod) and the Vite dev
# proxy both route to the backend. Set it only when the API lives on a
# different origin than the frontend.
# VITE_API_URL=https://api.example.com/api/v1
