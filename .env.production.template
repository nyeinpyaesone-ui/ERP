# ERP SOLUTION — Production Environment Template
# Copy this to /opt/erp-solution/.env.production on your server and fill in REAL values
# DO NOT COMMIT THE ACTUAL .env.production WITH REAL SECRETS

# Image tag / registry used by docker-compose.prod.yml
VERSION=latest
DOCKER_USER=your-dockerhub-username

# ============================================
# DATABASE
# ============================================
DB_USER=erp
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24
DB_NAME=erp_solution

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

# ============================================
# SECURITY
# ============================================
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Generate: openssl rand -hex 32
# NOTE: The backend refuses to start if SECRET_KEY is empty or left at its default.

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS & DOMAINS
# ============================================
CORS_ORIGINS=https://app.yourdomain.com
API_URL=https://api.yourdomain.com
WS_URL=wss://api.yourdomain.com

# ============================================
# AI / OLLAMA (internal only)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Optional: OpenAI API key for GPT-4 features (leave empty to use Ollama only)
OPENAI_API_KEY=

# ============================================
# FILE STORAGE (optional — only if STORAGE_TYPE != local)
# ============================================
STORAGE_TYPE=local
# Options: local, s3, minio
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=ap-southeast-1

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=noreply@yourdomain.com

# ============================================
# STRIPE (optional — leave EMPTY to disable payment features)
# ============================================
# Paste real keys only in .env / .env.production, never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================
# MONITORING (optional — leave EMPTY to disable Sentry)
# ============================================
SENTRY_DSN=
ENVIRONMENT=production

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# ============================================
# WEBSOCKET
# ============================================
WS_HEARTBEAT_INTERVAL=30
# ── Frontend (Vite build-time, baked into frontend image) ──
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com
