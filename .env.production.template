# ERP SOLUTION — Production Environment Template
# Copy this to /opt/erp-solution/.env.production on your server and fill in REAL values
# DO NOT COMMIT THE ACTUAL .env.production WITH REAL SECRETS

# ============================================
# DATABASE
# ============================================
DB_USER=erp
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24
DB_NAME=erp_solution

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

# ============================================
# SECURITY
# ============================================
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Generate: openssl rand -hex 32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS & DOMAINS
# ============================================
CORS_ORIGINS=https://app.yourdomain.com
API_URL=https://api.yourdomain.com
WS_URL=wss://api.yourdomain.com

# ============================================
# AI / OLLAMA (internal only)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# STRIPE (optional)
# ============================================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ============================================
# MONITORING (optional)
# ============================================
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
ENVIRONMENT=production

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# ============================================
# WEBSOCKET
# ============================================
WS_HEARTBEAT_INTERVAL=30