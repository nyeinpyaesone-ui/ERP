# ERP SOLUTION — Production Environment Template
# Copy this to /opt/erp-solution/.env.production on your server and fill in REAL values
# DO NOT COMMIT THE ACTUAL .env.production WITH REAL SECRETS

# ============================================
# DATABASE
# ============================================
DB_USER=erp
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24
DB_NAME=erp_solution

# ============================================
# REDIS
# ============================================
REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_24

# ============================================
# SECURITY
# ============================================
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Generate: openssl rand -hex 32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS
# ============================================
CORS_ORIGINS=https://app.yourdomain.com

# ============================================
# AI / OLLAMA (internal only)
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ============================================
# EMAIL
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# STRIPE (optional)
# ============================================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

ENVIRONMENT=prod
# Must be exactly dev|test|prod — Settings uses a Literal, so "production"
# raises at startup and the container will not boot. docker-compose.prod.yml
# hardcodes this too; keep the two in sync.

# ============================================
# NOT read by the backend
# ============================================
# Listed so nobody chases them. docker-compose.prod.yml builds DATABASE_URL and
# REDIS_URL from DB_* / REDIS_PASSWORD above, so the app never sees those as
# separate fields. There is no Sentry SDK dependency in requirements.txt, and
# nothing resolves the frontend's API origin from these (nginx proxies /api and
# the Vite bundle hardcodes its baseURL), so API_URL / WS_URL have no consumer.
SENTRY_DSN=
API_URL=
WS_URL=

# ============================================
# DOCKER
# ============================================
# Read by docker-compose.prod.yml and scripts/deploy-blue-green.sh, not by the
# app. VERSION is overridden per release by the CI tag-deploy jobs.
DOCKER_USER=powerrangeranikg
VERSION=latest

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# ============================================
# WEBSOCKET
# ============================================
WS_HEARTBEAT_INTERVAL=30